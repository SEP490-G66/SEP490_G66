# Application Port mapping on Host machine
HOST_PORT=5000
ASPNETCORE_ENVIRONMENT=Production

# Reverse proxy (Nginx → container HTTP). Set false when Nginx owns HTTP→HTTPS redirects.
# Maps to ReverseProxy__UseHttpsRedirection / ReverseProxy__KnownProxies__0 inside the container.
# Set KnownProxies to the Docker network gateway (or host proxy IP) for your environment — do not commit VPS-specific values elsewhere.
REVERSE_PROXY_USE_HTTPS_REDIRECTION=false
# REVERSE_PROXY_KNOWN_PROXIES_0=172.18.0.1

# Browser origins allowed to call the API and /hubs/notifications (no wildcards; required outside Development).
# Maps to Cors__AllowedOrigins__0 inside the container. Add Cors__AllowedOrigins__1 etc. for more origins.
CORS_ALLOWED_ORIGINS_0=https://oze-clinic.vercel.app

# Database Connection String (Replace with your actual SQL Server address and credentials)
# In Docker, if SQL Server is running on host machine:
# Linux host: use host.docker.internal or your server local IP
# Remote DB: use your server IP / domain
CONNECTION_STRING=Server=your_sql_server_host,1433;Initial Catalog=OzeDatabase;User ID=sa;Password=YourPassword123;TrustServerCertificate=True;

# JWT Authentication
JWT_KEY=b8959408-5a17-4143-8b73-462065cd69814d0ee596-25e2-4bd0-aa6a-68997549bd199276a1fe-1d9d-4d81-b780-3136034ca3ab
JWT_ISSUER=OZEApp
JWT_AUDIENCE=OZEApi
JWT_EXPIRES_IN_MINUTES=60

# Email Sender Service (SendGrid)
SENDGRID_KEY=
SENDER_EMAIL=support@oze.com
SENDER_NAME=OZE Support

# SMS Sender Service (eSMS) — leave ApiKey/SecretKey empty to skip network send (OTP logged only)
# Sandbox=1 tests connectivity without delivering SMS; set 0 after Brandname/template are approved
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=
ESMS_SMS_TYPE=2
ESMS_IS_UNICODE=0
ESMS_SANDBOX=1
# OTP SMS text; {otp} and {minutes} are filled in. Leave empty for the default OZE text.
# With a Brandname the text must match its approved template word for word, e.g. for the eSMS test Brandname:
# ESMS_OTP_TEMPLATE={otp} la ma xac minh dang ky Baotrixemay cua ban
ESMS_OTP_TEMPLATE=
ESMS_RESET_PASSWORD_OTP_TEMPLATE=
